<section class="ds-death-settings scrollable">
  <fieldset>
    <legend>{{localize "DSDS.Settings.General"}}</legend>
    <div class="form-group">
      <label>{{localize "DSDS.Settings.AutoEnable"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="autoEnable" {{#if autoEnable}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "DSDS.Settings.AutoEnableHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "DSDS.Settings.Images"}}</legend>

    {{#if images.length}}
    <div class="ds-images">
      {{#each images}}
      <div class="ds-image-card">
        <img src="{{this.src}}" alt="" data-tooltip="{{this.src}}">
        <label class="ds-radio">
          <input type="radio" name="selected" value="{{this.src}}" {{#if this.selected}}checked{{/if}}>
          <span>{{localize "DSDS.Settings.Choose"}}</span>
        </label>
        <button type="button" class="icon-button" data-action="removeImage" data-index="{{@index}}">
          <i class="fa-solid fa-trash"></i> {{localize "DSDS.Settings.Remove"}}
        </button>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="hint">{{localize "DSDS.Settings.NoImages"}}</p>
    {{/if}}

    <div class="form-group">
      <label></label>
      <div class="form-fields">
        <button type="button" data-action="addImage"><i class="fa-solid fa-plus"></i> {{localize "DSDS.Settings.AddImage"}}</button>
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "DSDS.Settings.Mode"}}</label>
      <div class="form-fields">
        <select name="mode">
          <option value="random" {{#if modeRandom}}selected{{/if}}>{{localize "DSDS.Settings.ModeRandom"}}</option>
          <option value="specific" {{#unless modeRandom}}selected{{/unless}}>{{localize "DSDS.Settings.ModeSpecific"}}</option>
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "DSDS.Settings.Sound"}}</legend>

    <div class="form-group">
      <label>{{localize "DSDS.Settings.SoundFile"}}</label>
      <div class="form-fields">
        <input type="text" name="sound" value="{{sound}}">
        <button type="button" class="icon fa-solid fa-file-audio" data-action="pickSound" data-tooltip="{{localize 'DSDS.Settings.Browse'}}" aria-label="{{localize 'DSDS.Settings.Browse'}}"></button>
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "DSDS.Settings.Volume"}}</label>
      <div class="form-fields">
        <range-picker name="volume" min="0" max="1" step="0.05" value="{{volume}}"></range-picker>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "DSDS.Settings.Timings"}}</legend>

    <div class="form-group">
      <label>{{localize "DSDS.Settings.FadeIn"}}</label>
      <div class="form-fields"><input type="number" name="fadeIn" value="{{fadeIn}}" min="0" step="50"></div>
    </div>

    <div class="form-group">
      <label>{{localize "DSDS.Settings.Hold"}}</label>
      <div class="form-fields"><input type="number" name="hold" value="{{hold}}" min="0" step="50"></div>
    </div>

    <div class="form-group">
      <label>{{localize "DSDS.Settings.FadeOut"}}</label>
      <div class="form-fields"><input type="number" name="fadeOut" value="{{fadeOut}}" min="0" step="50"></div>
    </div>

    <div class="form-group">
      <label>{{localize "DSDS.Settings.Offset"}}</label>
      <div class="form-fields"><input type="number" name="offset" value="{{offset}}" step="50"></div>
      <p class="hint">{{localize "DSDS.Settings.OffsetHint"}}</p>
    </div>
  </fieldset>
</section>
